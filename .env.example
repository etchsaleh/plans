# Copy to .env.local. Everything has a dev default except where noted.
APP_URL=http://localhost:3000
DATABASE_URL=postgres://plan@localhost:5433/plan
# Required in production (≥32 chars): openssl rand -base64 48
COOKIE_SECRET=
LOG_LEVEL=info
# Optional — enables the Claude ranker; otherwise a deterministic heuristic ranks candidates
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Optional — SMTP for magic links (smtp://user:pass@host:587). Unset: links go to the log + /dev/mailbox
SMTP_URL=
MAIL_FROM=Plan <plans@example.com>
# Comma list of verifiers to enable
VERIFIERS=mock,playtomic,royalparks
# Live checks against real sources. The project owner confirmed permission on 2026-11-20; keep the
# written permission on file (docs/adapters/README.md). Set false to fall back to link-only.
ROYALPARKS_PERMISSION_ON_FILE=true
PLAYTOMIC_PERMISSION_ON_FILE=true
# Set true after confirming Playtomic slot times are London-local during British Summer Time
PLAYTOMIC_BST_VERIFIED=false
